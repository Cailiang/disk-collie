{
  "name": "memento",
  "version": "1.0.17",
  "private": true,
  "author": {
    "name": "Cailiang",
    "email": "1006980793@qq.com"
  },
  "description": "A local desktop maintenance Agent with user-configured models and confirmed actions.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "npm run native:build && electron-vite dev",
    "dev:web": "vite --config vite.renderer.config.ts --host 127.0.0.1",
    "icon": "node scripts/generate-icon.mjs",
    "build": "npm run native:build && npm run typecheck && electron-vite build",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "preview": "electron-vite preview",
    "scan:smoke": "vite-node scripts/smoke-scan.ts && node scripts/native-smoke.mjs",
    "electron:smoke": "node scripts/electron-smoke.mjs",
    "ui:smoke": "node scripts/visual-smoke.mjs",
    "release:collect": "vite-node --script scripts/collect-release-artifacts.ts",
    "audit": "npm audit --registry=https://registry.npmjs.org",
    "audit:runtime": "npm audit --omit=dev --registry=https://registry.npmjs.org",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "native:build": "node scripts/build-native.mjs",
    "native:test": "cargo test --manifest-path native/Cargo.toml",
    "native:smoke": "node scripts/native-smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.23",
    "@ai-sdk/google": "^4.0.27",
    "@ai-sdk/openai": "^4.0.23",
    "@ai-sdk/openai-compatible": "^3.0.16",
    "ai": "^7.0.41",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "js-yaml": "^5.2.2",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "electron-updater": {
      "js-yaml": "4.3.2"
    },
    "electron-builder": {
      "js-yaml": "4.3.2"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "build": {
    "appId": "com.fcl.memento",
    "productName": "Memento",
    "publish": {
      "provider": "github",
      "owner": "Cailiang",
      "repo": "memento-client"
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/native/${arch}",
        "to": "native"
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "forceCodeSigning": true,
      "hardenedRuntime": true,
      "signIgnore": [
        "\\.pak$"
      ],
      "notarize": true,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Utility",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.AppImage"
    },
    "deb": {
      "artifactName": "${productName}-${version}-${arch}.deb"
    },
    "beforePack": "scripts/prepare-native.cjs"
  }
}
